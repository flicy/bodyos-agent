{
    admin off
    auto_https off
}

:8080 {
    encode zstd gzip
    handle /.well-known/acme-challenge/* {
        root * /srv/acme
        file_server
    }
    handle /healthz {
        reverse_proxy api:8000
    }
    handle {
        respond "HTTPS required" 426
    }
    log {
        output stdout
        format filter {
            wrap json
            fields {
                request>uri delete
                request>headers delete
                response>headers delete
            }
        }
    }
}
