# FitCrew .env 模板 —— install.sh 替换占位符后写入 profile 的 .env
# 这个文件指向 profile 自身（install.sh 会设好）
MOTICLAW_HERMES_PROFILE_ENV_PATH=__PROFILE_DIR__/.env

# ===== 飞书凭据（在飞书开放平台创建企业自建应用后获取）=====
FEISHU_APP_ID=__FEISHU_APP_ID__
FEISHU_APP_SECRET=__FEISHU_APP_SECRET__
FEISHU_DOMAIN=feishu
FEISHU_CONNECTION_MODE=websocket
FEISHU_ALLOW_ALL_USERS=false
GATEWAY_ALLOW_ALL_USERS=false
# 管理单聊的 chat_id（机器人接收指令/汇报的默认会话）
FEISHU_HOME_CHANNEL=__FEISHU_HOME_CHANNEL__
FEISHU_HOME_CHANNEL_NAME=FitCrew

# ===== BodyOS 预模型隐私边界与零新增付费模型路由 =====
BODYOS_API_BASE=__BODYOS_API_BASE__
BODYOS_INTERNAL_TOKEN=__BODYOS_INTERNAL_TOKEN__
BODYOS_MODEL_PROXY_TOKEN=__BODYOS_MODEL_PROXY_TOKEN__
OPENAI_API_KEY=${BODYOS_MODEL_PROXY_TOKEN}
OPENAI_BASE_URL=__BODYOS_MODEL_BASE_URL__
BODYOS_SANITIZED_CACHE_DIR=__PROFILE_DIR__/.bodyos-sanitized

# ===== @提及巡检脚本可选项 =====
# 机器人在飞书里显示的名字（用于识别 @提及），默认 Moticlaw飞书助手
FITCREW_BOT_NAME=Moticlaw飞书助手
